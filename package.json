{
	"name": "genai-ai-api",
	"version": "1.0.0",
	"repository": "https://github.com/sanpoyoshi-commons/genai-ai-api-onpre",
	"type": "module",
	"engines": {
		"node": ">=24.15.0"
	},
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"dev": "tsx watch src/index.ts",
		"typecheck": "tsc --noEmit",
		"test": "node --test --import tsx 'tests/**/*.test.ts'",
		"lint": "biome lint",
		"lint:fix": "biome lint --fix",
		"format": "biome format --write",
		"format:check": "biome format",
		"check": "biome check",
		"check:fix": "biome check --fix",
		"db:generate": "prisma generate",
		"db:migrate:dev": "prisma migrate dev",
		"db:migrate:deploy": "prisma migrate deploy"
	},
	"dependencies": {
		"@aws-sdk/client-bedrock-runtime": "3.1049.0",
		"@aws-sdk/client-s3": "3.1049.0",
		"@aws-sdk/client-sqs": "3.1049.0",
		"@aws-sdk/s3-request-presigner": "3.1049.0",
		"@prisma/adapter-pg": "7.10.0",
		"@prisma/client": "7.10.0",
		"express": "^5.0.0",
		"jose": "6.2.3",
		"mammoth": "1.12.3",
		"node-html-parser": "9.0.4",
		"openai": "6.38.0",
		"pdfjs-dist": "6.3.289",
		"pg": "8.21.0",
		"pino": "^10.0.0",
		"pino-http": "^11.0.0",
		"read-excel-file": "9.3.10",
		"undici": "^7.29.1",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.4",
		"@types/express": "^5.0.0",
		"@types/node": "^24.0.0",
		"prisma": "7.10.0",
		"tsx": "^4.0.0",
		"typescript": "^6.0.0"
	},
	"overrides": {
		"esbuild": "0.28.1",
		"hono": "4.13.7",
		"@hono/node-server": "1.19.13",
		"fast-uri": "3.1.8",
		"body-parser": "2.3.0",
		"mysql2": "3.23.1",
		"qs": "6.16.0",
		"deepmerge-ts": "8.0.0",
		"saxen": "11.1.1"
	}
}
